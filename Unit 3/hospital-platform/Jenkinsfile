pipeline {
    agent any

    environment {
        IMAGE_NAME = 'hospital-platform'
        IMAGE_TAG  = "v1.${BUILD_NUMBER}"
        KUBECONFIG    = 'C:\\Users\\SAINATH\\.kube\\config'
        MINIKUBE_HOME = 'C:\\Users\\SAINATH\\.minikube'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    triggers { pollSCM('H/2 * * * *') }

    stages {
        stage('SCM Checkout') {
            steps { checkout scm }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                    python --version
                    python -m venv venv
                    venv\\Scripts\\python -m pip install --upgrade pip
                    venv\\Scripts\\python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Quality Gates') {
            parallel {
                stage('Lint (Flake8)') {
                    steps {
                        bat 'venv\\Scripts\\python -m flake8 app/ --max-line-length=120 --count --statistics'
                    }
                }
                stage('Unit & API Tests') {
                    steps {
                        bat '''
                            if not exist reports mkdir reports
                            venv\\Scripts\\python -m pytest -v --cov=app --cov-fail-under=80 --junitxml=reports/test-results.xml
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    docker build -t %IMAGE_NAME%:%IMAGE_TAG% .
                    docker tag %IMAGE_NAME%:%IMAGE_TAG% %IMAGE_NAME%:latest
                '''
            }
        }

        stage('Image Security Scan (Trivy)') {
            steps {
                bat '''
                    docker save %IMAGE_NAME%:%IMAGE_TAG% -o hospital-image.tar
                    if errorlevel 1 exit /b 1

                    docker run --rm ^
                      -v "%CD%\\hospital-image.tar:/tmp/hospital-image.tar:ro" ^
                      aquasec/trivy:latest image ^
                      --input /tmp/hospital-image.tar ^
                      --db-repository ghcr.io/aquasecurity/trivy-db:2 ^
                      --severity HIGH,CRITICAL ^
                      --exit-code 0
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Deploy to Minikube') {
            steps {
                bat '''
                    set "PATH=C:\\Program Files\\Kubernetes\\Minikube;%PATH%"
                    set "PATH=C:\\Users\\SAINATH\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;%PATH%"
                    set "KUBECONFIG=C:\\Users\\SAINATH\\.kube\\config"
                    set "MINIKUBE_HOME=C:\\Users\\SAINATH\\.minikube"

                    echo Checking Minikube...
                    "C:\\Program Files\\Kubernetes\\Minikube\\minikube.exe" --profile=minikube status
                    if errorlevel 1 exit /b 1

                    echo Checking Kubernetes connection...
                    kubectl get nodes
                    if errorlevel 1 exit /b 1

                    echo Loading application image...
                    minikube image load %IMAGE_NAME%:%IMAGE_TAG%
                    if errorlevel 1 exit /b 1

                    echo Applying Kubernetes manifests...
                    kubectl apply -f k8s/
                    if errorlevel 1 exit /b 1

                    echo Updating application image...
                    kubectl set image deployment/hospital-api api=%IMAGE_NAME%:%IMAGE_TAG%
                    if errorlevel 1 exit /b 1

                    echo Waiting for deployment rollout...
                    kubectl rollout status deployment/hospital-api --timeout=180s
                    if errorlevel 1 exit /b 1

                    echo Checking deployed resources...
                    kubectl get deployments
                    kubectl get pods
                    kubectl get services
                '''
            }
        }
    }
    post {
        always {
            junit allowEmptyResults: true, testResults: 'reports/test-results.xml'
            cleanWs deleteDirs: true, notFailBuild: true
        }
        success { echo "Build #${BUILD_NUMBER} deployed as ${IMAGE_NAME}:${IMAGE_TAG}" }
        failure { echo "Build #${BUILD_NUMBER} FAILED - check console output" }
    }
}
